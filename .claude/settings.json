{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add -N *)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(git push *)",
      "Bash(git push)"
    ],
    "deny": [
      
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git config --global *)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",
      "Bash(npm publish *)",
      "Bash(twine upload *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)"
    ]
  }
}
